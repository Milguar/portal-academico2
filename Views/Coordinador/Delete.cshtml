@model portal_academico.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Está seguro de eliminar este curso?</h3>
<div>
    <h4>Curso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Codigo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Creditos)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Creditos)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CupoMaximo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CupoMaximo)</dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Cursos" class="btn btn-secondary">Cancelar</a>
    </form>
</div>